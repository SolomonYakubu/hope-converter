{
  "name": "hope-converter",
  "version": "0.2.0",
  "description": "A secure, polished desktop media converter powered by FFmpeg.",
  "main": "out/main/main.js",
  "author": "Hope Converter contributors",
  "license": "MIT",
  "homepage": "https://github.com/solomonyakubu/hope-converter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solomonyakubu/hope-converter.git"
  },
  "bugs": {
    "url": "https://github.com/solomonyakubu/hope-converter/issues"
  },
  "keywords": [
    "electron",
    "ffmpeg",
    "video-converter",
    "audio-converter",
    "image-converter",
    "offline",
    "privacy"
  ],
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "accents": "node scripts/build-accents.mjs",
    "logos": "node scripts/build-logos.mjs",
    "fetch:models": "node scripts/fetch-denoise-assets.mjs",
    "prebuild": "npm run fetch:models",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "2.1.2",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
